#!/usr/bin/env bash
# env.sh.example — Template for environment variables.
# Copy to env.sh and fill in your values:
#   cp env.sh.example env.sh
#   vi env.sh
#   source env.sh

export SUBSCRIPTION_ID="<your-subscription-id>"
export RESOURCE_GROUP="<your-resource-group>"

export BATCH_ACCOUNT="<your-batch-account>"
export BATCH_ACCOUNT_NAME="<your-batch-account>"

export PRIMARY_POOL="<your-primary-pool-id>"
export FALLBACK_POOL="<your-backup-pool-id>"

export JOB_PREFIX="batch-run"
export COMMAND="/bin/bash -c 'echo hello from batch job'"
export MAX_WAIT_MINUTES="15"

export WORKSPACE_NAME="<your-log-analytics-workspace>"
